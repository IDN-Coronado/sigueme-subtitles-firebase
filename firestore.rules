rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOperator() {
      return request.auth != null
        && get(/databases/$(database)/documents/operators/$(request.auth.uid)).data.approved == true;
    }

    // Operator directory. `approved` is only ever set by an admin from the
    // Firebase console (allow update, delete: if false below) — a signed-in
    // user can register a pending request for themselves but can never
    // approve themselves or anyone else.
    match /operators/{uid} {
      allow read: if request.auth.uid == uid || isOperator();
      allow create: if request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'requestedAt']);
      allow update, delete: if false;
    }

    // Broadcast target for the public /caption route: readable by anyone,
    // writable only by approved operators. The console and the Live window are
    // two windows on one machine, so preview/preview is gone — it is a
    // BroadcastChannel now (src/firebase/usePreview.js).
    match /caption/caption {
      allow read: if true;
      allow write: if isOperator();
    }

    // Programs, themes and media moved into the desktop app's local data.json.
    // Read access stays so the first-run import can pull existing data across;
    // writes are gone because nothing writes them any more.
    match /programs/{id} { allow read: if isOperator(); }
    match /themes/{id} { allow read: if isOperator(); }
    match /media/{id} { allow read: if isOperator(); }

    // Songs stay writable: this collection is the shared repository operators
    // import from. Publishing back to it is deliberately not built yet.
    match /songs/{id} { allow read, write: if isOperator(); }
  }
}
