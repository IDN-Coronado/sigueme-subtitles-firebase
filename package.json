{
  "name": "apostello",
  "version": "2.0.0",
  "private": true,
  "description": "Presentation console for church services — programs, songs, themes and live captions.",
  "author": "IDN Coronado",
  "main": "electron/main.js",
  "homepage": "https://siguemesubtitles.web.app/",
  "engines": {
    "node": "26.5.0",
    "npm": "11.17.0"
  },
  "dependencies": {
    "autoprefixer": "^10.5.0",
    "dayjs": "^1.11.13",
    "dompurify": "^3.2.6",
    "firebase": "^9.17.2",
    "firebase-cli": "^1.2.0",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^6.3.289",
    "pptxviewjs": "^1.1.9",
    "react": "^19.0.0",
    "react-color": "^2.19.3",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.9.0",
    "tinycolor2": "^1.6.0",
    "zustand": "^5.0.6"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "vite build && electron .",
    "desktop:dev": "electron . --dev",
    "package": "vite build && electron-builder",
    "test:electron": "node --test electron/electron.test.js",
    "lhci:mobile": "lhci autorun",
    "lhci:desktop": "lhci autorun --collect.settings.preset=desktop"
  },
  "build": {
    "appId": "app.siguemesubtitles.apostello",
    "productName": "Apostello",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist/**",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      ".env"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "packageManager": "npm@11.17.0",
  "devDependencies": {
    "@lhci/cli": "^0.14.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.4.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^3.2.7",
    "vite": "^6.4.3"
  },
  "allowScripts": {
    "electron@43.4.0": true
  }
}
