rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOperator() {
      // ponytail: Storage rules can't read Firestore, so this list is a
      // manual mirror of approved operators/{uid} docs (firestore.rules).
      // Keep it in sync by hand when approving/revoking someone in the
      // Firebase console. Upgrade to custom claims (Admin SDK) if
      // operators change often enough that this becomes a chore.
      return request.auth != null && request.auth.token.email in [
        'jrgherrera@gmail.com',
        'danieleiton05@gmail.com'
      ];
    }

    // Assets live on disk now (electron/media.js). The only code left that
    // touches this bucket is the one-time import in src/local/migrateMedia.js,
    // which lists and downloads — so writes are gone and reads are limited to
    // operators, no longer public. Once every machine has run the import, this
    // file, storage.cors.json and the bucket itself can go.
    match /general/{fileName} {
      allow read: if isOperator();
      allow write: if false;
    }

    match /themes/{fileName} {
      allow read: if isOperator();
      allow write: if false;
    }
  }
}
